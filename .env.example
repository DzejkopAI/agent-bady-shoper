# Skopiuj do .env i uzupełnij. Pliku .env NIE commituj.

# ── Claude (mózg) ──────────────────────────────────────────────
# Klucz do Claude API (https://console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=sk-ant-...
# ID modelu Claude (https://docs.claude.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Shoper REST API (ścieżka produkcyjna) ──────────────────────
# base_url = adres sklepu BEZ /admin. Token z panelu (Integracje) — ten sam
# sklep co PIM (jego config.json → shoper_api.access_token).
SHOPER_API_BASE_URL=https://pamiatkizpolski.pl
SHOPER_API_TOKEN=WPISZ_TOKEN_API
SHOPER_API_CLIENT_ID=
# Fallback zamiast tokenu: konto WebAPI login+hasło → /webapi/rest/auth
SHOPER_API_LOGIN=
SHOPER_API_PASSWORD=
# Producent (reguła 4): „Pamiątki z Polski" = id 1. Kategoria awaryjna, gdy
# mapowanie nie trafi w istniejącą kategorię sklepu.
SHOPER_PRODUCER_ID=1
SHOPER_FALLBACK_CATEGORY=Pozostałe

# ── Reguły runu ────────────────────────────────────────────────
# Ile NOWYCH produktów dodać w jednym uruchomieniu.
MAX_PRODUCTS=10
# Nazwy do wykluczenia (po przecinku, lowercase). „personalizowan" = półprodukt
# do znakowania — nie trafia do sklepu.
EXCLUDE_NAME_CONTAINS=personalizowan

# ── Powiadomienia e-mail (SMTP) — mail „co dodałem" po runie ────
MAIL_ENABLED=true
SMTP_HOST=smtp.twojdostawca.pl
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=konto@twojadomena.pl
SMTP_PASS=WPISZ_HASLO_SMTP
SMTP_FROM=konto@twojadomena.pl
# Odbiorcy powiadomień (po przecinku)
MAIL_TO=sklep@pamiatkizpolski.pl

# ── LEGACY (ścieżka browser/CDP — nieużywana w produkcji) ──────
# Zostaje dla `npm run browser`/panel.ts jako referencja/fallback.
SHOPER_ADMIN_URL=https://sklep5452789.homesklep.pl/admin
SHOPER_LOGIN=twoj_login
SHOPER_PASSWORD=twoje_haslo
