# Skopiuj do .env i uzupełnij. Pliku .env NIE commituj.

# Klucz do Claude API (https://console.anthropic.com → API Keys).
# To jest jedyne "połączenie z Claude" jakiego agent potrzebuje.
ANTHROPIC_API_KEY=sk-ant-...

# ID modelu Claude. Aktualne ID sprawdź na https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Panel Shoper
SHOPER_ADMIN_URL=https://sklep5452789.homesklep.pl/admin
SHOPER_LOGIN=twoj_login
SHOPER_PASSWORD=twoje_haslo

# Ile produktów przetworzyć w jednym uruchomieniu
MAX_PRODUCTS=3

# true = widoczna przeglądarka (podglądasz co robi), false = w tle (headless)
HEADFUL=true
